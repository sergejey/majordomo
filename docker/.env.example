# Copy to .env before starting the stack.
TAG=local
PHP_VERSION=8.3

WEB_PORT=8080
BASE_URL=http://127.0.0.1:8080

DB_NAME=db_terminal
DB_USER=mj
DB_PASSWORD=change-me-db
MARIADB_ROOT_PASSWORD=change-me-root

# Write config.php from environment on every container start.
# Set to 0 if you maintain config.php yourself.
GENERATE_CONFIG=1
